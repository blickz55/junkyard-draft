{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "phaser": ["./node_modules/phaser/types/phaser.d.ts", "./vendor/phaser/types/phaser.d.ts"] }
  },
  "include": ["game/src/**/*.ts", "tests/**/*.ts", "tools/**/*.ts"]
}
