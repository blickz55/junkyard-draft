.dev-build/
_delivery/

# deep-research scratch (final reports are copied into docs/research/)
research_notes/
reports/

# browser-pane downloads and preview scratch land in the working directory
/junkyard-*.gif
/junkyard-*.webm
/_tmp-*
/tools/scratch-*

# deploy secrets and the per-host compose variables (deploy/*.example are the templates)
deploy/.env
deploy/verifier.env
