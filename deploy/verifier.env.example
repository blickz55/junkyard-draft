# the verifier container's environment (copy to deploy/verifier.env; that file is not committed, mode 600)
# Secrets: generate with `openssl rand -hex 32`, store both in the password manager (server/README.md, Secrets).
# The daily secret mints every ranked seed: losing it breaks the commitment chain once, leaking it lets anyone
# pre-play future days. Never in a backup, never in a flag.
DAILY_SECRET=
MODERATION_TOKEN=
# the daily reminder (0.10.4): `npx web-push generate-vapid-keys` once, both lines in the password manager; empty = reminders off
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@junkyarddraft.com
# exactly the origin the game is served from (scheme + host, no path, no trailing slash); the game's CSP names the
# verifier the same way, so both must match the real hosts
CORS_ORIGIN=https://junkyarddraft.com
# optional: Discord announcements (0.7.6); leave empty until 0.8.9 sets up the server
DISCORD_WEBHOOK_URL=
# optional tuning (defaults in server/README.md): RATE_LIMIT=60 PLAYER_RATE_LIMIT=2 READ_RATE_LIMIT=300 WRITE_RATE_LIMIT=30
# MAX_PLAYERS=20000 RESIM_CAP_MS=10000 RESIM_QUEUE=32 EVENTS_RETENTION_DAYS=7 REPORT_HIDE_REPORTERS=2
# REPORTER_ESTABLISHED_DAYS=7 HIDE_EXPIRY_HOURS=72 BOT_PAR_CAP_MS=20000
