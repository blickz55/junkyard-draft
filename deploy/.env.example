# docker compose variables (copy to deploy/.env; that file is not committed)
# the apex domain the game is served from (Cloudflare Pages); the verifier answers on verify.<DOMAIN>
DOMAIN=junkyarddraft.com
# Let's Encrypt account email (expiry notices only)
ACME_EMAIL=you@example.com
# the verifier image tag to run; .github/workflows/deploy.yml rewrites this line on every tag deploy
VERIFIER_TAG=latest
