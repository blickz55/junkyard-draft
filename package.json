{
  "name": "junkyard-draft",
  "version": "0.7.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/blickz55/junkyard-draft.git"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Junkyard Draft — a 2D factory score-attack game (Phaser + TypeScript) with the Workshop Control Room development dashboard.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "policy": "node --import tsx tools/make-policy.ts",
    "policy:check": "node --import tsx tools/make-policy.ts --check",
    "dev:all": "node scripts/dev-all.mjs",
    "control-room": "node control-room/server.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "sim": "node --import tsx tools/sim-cli.ts",
    "autoplay": "node --import tsx tools/autoplay.ts",
    "shots": "node tools/playwright-shots.mjs",
    "funnel": "node --import tsx tools/funnel.ts",
    "selftest:instrumentation": "node control-room/selftest.mjs",
    "verifier": "node --import tsx server/verify.ts",
    "test:quick": "node --import tsx --test --test-reporter=spec \"tests/*.test.ts\" tests/control-room-state.test.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:icon": "node tools/make-icon.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win",
    "test:desktop": "node --test tests/desktop-smoke.test.mjs",
    "verifier:build": "esbuild server/verify.ts --bundle --platform=node --format=esm --target=node20 --outfile=server/dist/verify.mjs --log-level=warning",
    "verifier:prod": "node server/dist/verify.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"game/src/**/*.ts\" \"server/*.ts\" \"tools/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"control-room/*.mjs\" \"control-room/ui/*.js\" \"desktop/**/*.{js,mjs,cjs}\" \"eslint.config.mjs\"",
    "format:check": "prettier --check \"game/src/**/*.ts\" \"server/*.ts\" \"tools/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"control-room/*.mjs\" \"control-room/ui/*.js\" \"desktop/**/*.{js,mjs,cjs}\" \"eslint.config.mjs\"",
    "test:unit": "node --import tsx --test --test-reporter=spec --experimental-test-coverage --test-coverage-include=\"game/src/sim/**\" --test-coverage-include=\"server/**\" --test-coverage-exclude=\"server/dist/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=88 --test-skip-pattern=\"computed off the request path\" \"tests/*.test.ts\" tests/control-room-state.test.mjs && npm run test:par",
    "test:e2e": "node --import tsx --test --test-reporter=spec \"tests/*-e2e.test.mjs\" tests/deploy.test.mjs tests/control-room-live.test.mjs tests/desktop-smoke.test.mjs",
    "test:par": "node --import tsx --test --test-reporter=spec --test-name-pattern=\"computed off the request path\" tests/verifier.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "phaser": "3.90.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "dev.junkyarddraft.app",
    "productName": "Junkyard Draft",
    "copyright": "Copyright © 2026",
    "directories": {
      "buildResources": "desktop/build",
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "desktop/build/icon.png",
      "target": [
        {
          "target": "dir"
        },
        {
          "target": "nsis"
        }
      ],
      "artifactName": "Junkyard-Draft-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "desktop/build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "icon": "desktop/build/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Junkyard Draft",
      "uninstallDisplayName": "Junkyard Draft"
    }
  },
  "author": "Jon"
}
