{
  "name": "junkyard-draft",
  "version": "0.2.0",
  "private": true,
  "description": "Junkyard Draft — a 2D factory score-attack game (Phaser + TypeScript) with the Workshop Control Room development dashboard.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "control-room": "node control-room/server.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/sim.test.ts tests/a11y.test.ts tests/share.test.ts tests/advice.test.ts tests/perf-gate.test.ts tests/quality.test.ts tests/undo.test.ts tests/controller.test.ts tests/tips.test.ts tests/telemetry.test.ts tests/tutorial.test.ts tests/storage.test.ts tests/verifier.test.ts tests/control-room-state.test.mjs tests/control-room-live.test.mjs tests/game-e2e.test.mjs tests/render-e2e.test.mjs tests/desktop-smoke.test.mjs",
    "sim": "node --import tsx tools/sim-cli.ts",
    "autoplay": "node --import tsx tools/autoplay.ts",
    "shots": "node tools/playwright-shots.mjs",
    "funnel": "node --import tsx tools/funnel.ts",
    "selftest:instrumentation": "node control-room/selftest.mjs",
    "verifier": "node --import tsx server/verify.ts",
    "test:quick": "node --import tsx --test tests/sim.test.ts tests/a11y.test.ts tests/share.test.ts tests/advice.test.ts tests/perf-gate.test.ts tests/quality.test.ts tests/undo.test.ts tests/controller.test.ts tests/tips.test.ts tests/telemetry.test.ts tests/tutorial.test.ts tests/storage.test.ts tests/verifier.test.ts tests/control-room-state.test.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:icon": "node tools/make-icon.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win",
    "test:desktop": "node --test tests/desktop-smoke.test.mjs",
    "verifier:build": "esbuild server/verify.ts --bundle --platform=node --format=esm --target=node20 --outfile=server/dist/verify.mjs --log-level=warning",
    "verifier:prod": "node server/dist/verify.mjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "phaser": "3.90.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "dev.junkyarddraft.app",
    "productName": "Junkyard Draft",
    "copyright": "Copyright © 2026",
    "directories": {
      "buildResources": "desktop/build",
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "desktop/build/icon.png",
      "target": [
        {
          "target": "dir"
        },
        {
          "target": "nsis"
        }
      ],
      "artifactName": "Junkyard-Draft-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "desktop/build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "icon": "desktop/build/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Junkyard Draft",
      "uninstallDisplayName": "Junkyard Draft"
    }
  },
  "author": "Jon"
}
